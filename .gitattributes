# Exclude HTML files from language statistics so GitHub Linguist classifies phone-library as Python
*.html linguist-generated=true
*.html linguist-detectable=false

# Exclude generated directories, templates, and data
build/** linguist-generated=true
site/** linguist-generated=true
site-web/** linguist-generated=true
selection/** linguist-generated=true
templates/** linguist-documentation=true
data/** linguist-generated=true
plans/** linguist-generated=true
tools/** linguist-vendored=true
